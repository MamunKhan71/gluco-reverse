{
  "hosting": {
    "public": "www",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "node_modules/**",
      "tests/**",
      "server.js",
      "package.json",
      "README.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
